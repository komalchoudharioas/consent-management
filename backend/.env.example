# Consent Manager configuration. All vars are prefixed CONSENT_MANAGER_.
# Copy to .env for local runs.

# ── Database ──────────────────────────────────────────────────────────────
CONSENT_MANAGER_DB_DRIVER=postgresql+asyncpg
CONSENT_MANAGER_DB_USERNAME=postgres
CONSENT_MANAGER_DB_PASSWORD=postgres
CONSENT_MANAGER_DB_HOSTNAME=localhost
CONSENT_MANAGER_DB_PORT=5432
CONSENT_MANAGER_DB_DBNAME=consent_manager_db

# NOTE: the data controller / module is a per-partner attribute set at onboarding
# (one shared CM serves many modules) — there is no global controller setting.

# ── CM receipt signing key (asymmetric, PKCS#12) ──────────────────────────
# Leave the path unset for local dev — an EPHEMERAL key is generated (fine for a
# single local process; receipts won't verify across restarts/pods).
# To sign with a real key, point P12_PATH at a .p12 keystore (+ its password).
# In Kubernetes the Helm chart supplies this: a bundled demo key by default, or
# a Secret you provide (signingKey.mode = demo | existing | inline). Generate one:
#   openssl genpkey -algorithm ed25519 -out cm_key.pem
#   openssl req -new -x509 -key cm_key.pem -out cm_cert.pem -days 3650 -subj "/CN=openg2p-consent-manager"
#   openssl pkcs12 -export -inkey cm_key.pem -in cm_cert.pem -out cm_signing.p12 -passout pass:changeit
# CONSENT_MANAGER_CM_SIGNING_P12_PATH=/path/to/cm_signing.p12
# CONSENT_MANAGER_CM_SIGNING_P12_PASSWORD=changeit
# Fallback PEM (used only if no .p12 path is set):
# CONSENT_MANAGER_CM_SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CONSENT_MANAGER_CM_SIGNING_KID=cm-2025-01
# Algorithm is auto-detected from the key type; this is only a fallback hint.
CONSENT_MANAGER_CM_SIGNING_ALGORITHM=EdDSA

# ── Replay / freshness ────────────────────────────────────────────────────
CONSENT_MANAGER_REPLAY_FRESHNESS_WINDOW_SEC=300

# ── Hot-path partner cache (pod-local TTL) ────────────────────────────────
CONSENT_MANAGER_PARTNER_CACHE_ENABLED=true
CONSENT_MANAGER_PARTNER_CACHE_TTL_SEC=60

# ── Partner Management: source of partner public keys ─────────────────────
# Partner signing keys live in Partner Management (PM), not CM. CM fetches them
# from GET {PARTNER_MGMT_API_URL}/keys/{reference_id}. EMPTY disables PM fetch,
# and verification then fails closed (no key -> deny) — the safe default.
CONSENT_MANAGER_PARTNER_MGMT_API_URL=http://commons-services-pm-partner-api:8000
# Crypto backend for verifying the partner-signed consent JWS.
CONSENT_MANAGER_CRYPTO_BACKEND=partner-mgmt
# Algorithms accepted on the partner consent JWS (fastapi-common defaults RS256).
CONSENT_MANAGER_CRYPTO_ALLOWED_ALGORITHMS=EdDSA,ES256,RS256
# Partner-key cache discipline (seconds). Soft TTL = refresh window; hard TTL =
# how long stale keys are served during a PM outage before failing closed.
CONSENT_MANAGER_PARTNER_KEY_CACHE_TTL_SECONDS=300
CONSENT_MANAGER_PARTNER_KEY_HARD_TTL_SECONDS=21600
CONSENT_MANAGER_PARTNER_KEY_NEGATIVE_TTL_SECONDS=30
CONSENT_MANAGER_PARTNER_KEY_REFRESH_COOLDOWN_SECONDS=10
CONSENT_MANAGER_PARTNER_KEY_FETCH_TIMEOUT_SECONDS=3.0

# ── Subject-granted consent in the hot path (gap B8) ──────────────────────
# ENABLED: an active originated artefact narrows /validate to what the subject
# actually granted. REQUIRED (strict): additionally DENY when there is no grant.
CONSENT_MANAGER_SUBJECT_CONSENT_ENABLED=true
CONSENT_MANAGER_SUBJECT_CONSENT_REQUIRED=false

# ── Caller authentication (Keycloak) ──────────────────────────────────────
# Protects admin, validate, lifecycle, and /my endpoints. Set auth_enabled=false
# only for local dev (tokens then accepted unverified, role checks pass).
CONSENT_MANAGER_AUTH_ENABLED=true
CONSENT_MANAGER_AUTH_ISSUER=https://keycloak.example.org/realms/staff
CONSENT_MANAGER_AUTH_JWKS_URL=https://keycloak.example.org/realms/staff/protocol/openid-connect/certs
CONSENT_MANAGER_AUTH_AUDIENCE=
CONSENT_MANAGER_AUTH_ADMIN_ROLE=CONSENT_MANAGER_ADMIN
# Role the Approvals screen / AWE task endpoints require (see AWE block below).
CONSENT_MANAGER_AUTH_APPROVER_ROLE=CONSENT_MANAGER_APPROVER
CONSENT_MANAGER_SUBJECT_DEFAULT_ID_TYPE=national_id

# ── OIDC (origination flow ID-token submitted to /authenticate) ───────────
# The IdP the subject authenticated with (may be the same Keycloak realm).
CONSENT_MANAGER_OIDC_JWKS_URL=
CONSENT_MANAGER_OIDC_ISSUER=
CONSENT_MANAGER_OIDC_AUDIENCE=

# ── Server ────────────────────────────────────────────────────────────────
CONSENT_MANAGER_APP_HOST=0.0.0.0
CONSENT_MANAGER_APP_PORT=8000
CONSENT_MANAGER_NO_OF_WORKERS=4

# ── AWE: Approval Workflow Engine (gates WIDENING partner-policy changes) ───
#
# What it does: when AWE_ENABLED=true and a policy change GRANTS broader access
# (more scopes/purposes, longer validity, weaker auth), CM saves the new policy
# as `pending` and submits an approval request to AWE. The prior policy stays in
# force until an approver decides. On approve, AWE POSTs a signed decision back
# to CM's webhook, which activates the pending version.
#
# When AWE_ENABLED=false (the default): every policy change — including widenings
# — activates IMMEDIATELY, with no approval step.
#
# IMPORTANT: the Approvals screen and GET /consent/v1/awe/tasks proxy to AWE and
# return 500 ("awe_base_url is not configured") whenever AWE_BASE_URL is empty,
# REGARDLESS of AWE_ENABLED. So if you don't run AWE, don't open the Approvals
# page. To use it, set AWE_ENABLED=true AND AWE_BASE_URL (and the auth block
# above must point at a real Keycloak — the Approvals proxy forwards the
# approver's own RS256 token; an unsigned dev token is rejected by AWE).
CONSENT_MANAGER_AWE_ENABLED=false
# Base URL of the AWE service, reachable from the CM backend. No trailing slash.
# Dev (K8s in-cluster): the AWE API service DNS, e.g. http://openg2p-awe-api:8000
# Local docker-compose:  http://awe:8000
CONSENT_MANAGER_AWE_BASE_URL=
CONSENT_MANAGER_AWE_HTTP_TIMEOUT_SECONDS=30
# AWE policy key that must already be registered/active in AWE, or saving a
# widening returns 502 (AWE-001: No active policy).
CONSENT_MANAGER_AWE_POLICY_CHANGE_POLICY_KEY=consent-manager.policy_change.v1

# Service-to-service auth CM uses to submit requests to AWE. Either the client
# credentials (preferred) OR a static token. TOKEN_URL's issuer host must match
# what AWE validates as `iss`.
CONSENT_MANAGER_AWE_TOKEN_URL=
CONSENT_MANAGER_AWE_CLIENT_ID=consent-manager-service
CONSENT_MANAGER_AWE_CLIENT_SECRET=
# Alternative to client credentials; leave empty if using CLIENT_ID/SECRET.
CONSENT_MANAGER_AWE_STATIC_TOKEN=

# Decision webhook: AWE POSTs terminal decisions here, HMAC-signed (no bearer).
# CALLBACK_URL is where AWE reaches THIS CM backend; SECRET_ID + HMAC_SECRET must
# match the credential registered in AWE for that callback.
CONSENT_MANAGER_AWE_CALLBACK_URL=
CONSENT_MANAGER_AWE_CALLBACK_SECRET_ID=
CONSENT_MANAGER_AWE_CALLBACK_HMAC_SECRET=
# Max clock skew (seconds) tolerated on the webhook's signed timestamp.
CONSENT_MANAGER_AWE_WEBHOOK_MAX_SKEW_SEC=300

# ── OTP: the subject's authentication on the consent screen ─────────────────
CONSENT_MANAGER_OTP_LENGTH=6
CONSENT_MANAGER_OTP_TTL_SEC=300
CONSENT_MANAGER_OTP_MAX_ATTEMPTS=3
# Mixed into the OTP hash so a stolen row cannot be brute-forced offline. CHANGE ME.
CONSENT_MANAGER_OTP_SALT=change-me-per-environment
# DEV ONLY: exposes GET /consent/v1/consent-requests/{id}/otp and logs the code.
CONSENT_MANAGER_OTP_DEBUG_ENABLED=false
# OTP backend: "fayda" (Fayda rules in-process) or "internal" (same, no framing).
CONSENT_MANAGER_OTP_PROVIDER=fayda

# ── OTP publishing (S3 / MinIO drop box) — DEV ONLY ─────────────────────────
# Writes each issued OTP to a bucket under otp/ so a tester can read it without
# an SMS gateway. Anything that can read the bucket reads a live OTP. Off by default.
CONSENT_MANAGER_OTP_PUBLISH_ENABLED=false
CONSENT_MANAGER_OTP_PUBLISH_BUCKET=a2c-webhook
CONSENT_MANAGER_OTP_PUBLISH_PREFIX=otp/
CONSENT_MANAGER_OTP_PUBLISH_REGION=ap-south-1
# Point at MinIO or any S3-compatible store; empty resolves AWS.
CONSENT_MANAGER_OTP_PUBLISH_ENDPOINT_URL=
CONSENT_MANAGER_OTP_PUBLISH_ACCESS_KEY=
CONSENT_MANAGER_OTP_PUBLISH_SECRET_KEY=

# ── Fayda (OTP provider; used when OTP_PROVIDER=fayda) ──────────────────────
# Base URL with no path (endpoints are /requestData and /getDataAuth). ENV and
# DOMAIN_URI must match the Fayda server's own values exactly or it 400s.
CONSENT_MANAGER_FAYDA_BASE_URL=
CONSENT_MANAGER_FAYDA_CLIENT_ID=demo-client
CONSENT_MANAGER_FAYDA_CLIENT_SECRET=demo-secret
CONSENT_MANAGER_FAYDA_VERSION=1.0
CONSENT_MANAGER_FAYDA_ENV=prod
CONSENT_MANAGER_FAYDA_DOMAIN_URI=fayda.et
CONSENT_MANAGER_FAYDA_IDENTIFIER_TYPE=FIN
CONSENT_MANAGER_FAYDA_OTP_CHANNEL=PHONE
CONSENT_MANAGER_FAYDA_DEMO_PHONE=0911000055
CONSENT_MANAGER_FAYDA_TIMEOUT=20.0
# Map a demo subject onto a Fayda/FIN number, as JSON: {"staff":"6140798523698702"}
CONSENT_MANAGER_FAYDA_INDIVIDUAL_ID_MAP=

# ── API audience / deployment shape ─────────────────────────────────────────
# staff | partner | beneficiary | all. "all" mounts every controller in one
# process (dev default). Split per audience for production.
CONSENT_MANAGER_API_AUDIENCE=all
